+// STEALTH PATCH (phase 3): fingerprint-noise seed. `--stealth-seed=N`
+// overrides the built-in default; the same seed always yields the same
+// noise, so repeated reads of one canvas stay consistent.
+uint32_t StealthSeed() {
+  static const uint32_t seed = [] {
+    const std::string value =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "stealth-seed");
+    uint32_t parsed = 0;
+    if (!value.empty() && base::StringToUint(value, &parsed)) {
+      return parsed;
+    }
+    return 0x5EEDC10Au;
+  }();
+  return seed;
+}
+
+// Deterministic 32-bit hash of (seed, x, y); splitmix32-style finalizer.
+uint32_t StealthPixelHash(uint32_t seed, uint32_t x, uint32_t y) {
+  uint32_t h = seed + 0x9E3779B9u + x * 0x85EBCA6Bu + y * 0xC2B2AE35u;
+  h ^= h >> 16;
+  h *= 0x7FEB352Du;
+  h ^= h >> 15;
+  h *= 0x846CA68Bu;
+  h ^= h >> 16;
+  return h;
+}
